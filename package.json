{
  "name": "google-news-scraper",
  "version": "3.0.1",
  "description": "Scrape Google News search results, topics and top stories as JSON. No headless browser, works on serverless, TypeScript types included.",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.mjs",
  "types": "./dist/tsc/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/tsc/index.d.ts",
      "import": "./dist/esm/index.mjs",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist/cjs",
    "dist/esm",
    "dist/tsc/**/*.d.ts"
  ],
  "scripts": {
    "test": "jest",
    "build:ts": "tsc",
    "build:rollup": "rollup -c",
    "build": "rm -rf ./dist/* && npm run build:ts && npm run build:rollup",
    "build:ci": "rm -rf ./dist/* && npm run build:ts && rollup -c --bundleConfigAsCjs",
    "pretest": "npm run build:ts"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/lewisdonovan/google-news-scraper"
  },
  "keywords": [
    "google news",
    "google-news",
    "news",
    "news api",
    "google news api",
    "news scraper",
    "scraper",
    "scraping",
    "rss",
    "news feed",
    "news monitoring",
    "media monitoring",
    "headlines",
    "serverless",
    "typescript",
    "web scraping",
    "crawler",
    "llm",
    "ai agents"
  ],
  "author": "Lewis Donovan",
  "license": "MIT",
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@rollup/plugin-babel": "^6.0.4",
    "cheerio": "^1.2.0",
    "jsdom": "^29.1.1",
    "winston": "^3.15.0"
  },
  "devDependencies": {
    "@babel/core": "^7.23.9",
    "@babel/plugin-transform-runtime": "^7.23.9",
    "@babel/preset-env": "^7.23.9",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.2.0",
    "@types/jsdom": "^21.1.7",
    "@types/winston": "^2.4.4",
    "babel-jest": "^29.7.0",
    "expect.js": "^0.3.1",
    "jest": "^29.7.0",
    "puppeteer": "^23.6.0",
    "rollup": "^4.24.0",
    "rollup-plugin-delete": "^2.1.0",
    "semantic-release": "^25.0.9",
    "typescript": "^5.6.3"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.24.2"
  },
  "funding": "https://donate.stripe.com/6oE7ue8n57wk4PS7ss",
  "peerDependencies": {
    "puppeteer": "^23.6.0"
  },
  "peerDependenciesMeta": {
    "puppeteer": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  }
}
